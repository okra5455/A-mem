# Copy this file to .env, fill in your key, then export the variables:
#
#     set -a; source .env; set +a
#
# The harness reads environment variables directly; it does not parse .env itself.

export OPENAI_API_KEY=sk-your-key-here
export OPENAI_BASE_URL=https://api.deepseek.com

# Optional: force CPU-only execution (uncomment if your GPU is unsupported)
# export CUDA_VISIBLE_DEVICES=

# Optional: non-default Ollama endpoint
# export OLLAMA_HOST=http://127.0.0.1:11434
